# Copy to .env and fill in. .env is git-ignored; never commit your key.

# --- LLM service (SoCLaaS, OpenAI-compatible). Needs NUS network or NUS VPN. ---
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=your-key-here
# Model id as listed by `python -m nesy check-env --llm` (e.g. qwen3.6:35b). "default" uses the gateway default.
SOCLAAS_MODEL=default

# --- Java installations (optional; auto-detected when empty) ---
# JDK 17+ used to RUN Tai-e and javac (driver compilation uses --release 8).
JAVA17_HOME=
# JDK 8 whose jre/lib/rt.jar is used as the ANALYSED Java library (-java 8). Also used to build subjects.
JAVA8_HOME=
# Maven executable (defaults to `mvn` on PATH)
MAVEN_BIN=
